rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User Profiles: /users/{userId}
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'displayName', 'email']) &&
        data.keys().hasOnly(['id', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().id == existing().id &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isOwner(userId);

      // 2. User Favorites Subcollection: /users/{userId}/favorites/{toolId}
      function isValidToolFavorite(data) {
        return data.keys().hasAll(['id', 'userId', 'toolId', 'toolName']) &&
          data.keys().hasOnly(['id', 'userId', 'toolId', 'toolName', 'arabicName', 'category', 'createdAt']) &&
          data.id is string && data.id.size() <= 128 &&
          data.userId is string && data.userId == request.auth.uid &&
          data.toolId is string && data.toolId.size() > 0 && data.toolId.size() <= 64 &&
          data.toolName is string && data.toolName.size() > 0 && data.toolName.size() <= 100 &&
          (!('arabicName' in data) || (data.arabicName is string && data.arabicName.size() <= 100)) &&
          (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
          (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
      }

      match /favorites/{toolId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(toolId) && isValidToolFavorite(incoming()) && incoming().toolId == toolId;
        allow update: if isOwner(userId) && isValidId(toolId) && isValidToolFavorite(incoming()) &&
          incoming().toolId == existing().toolId &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // 3. User Custom Prompts: /users/{userId}/custom_prompts/{promptId}
      function isValidCustomPrompt(data) {
        return data.keys().hasAll(['id', 'userId', 'toolName', 'title', 'prompt']) &&
          data.keys().hasOnly(['id', 'userId', 'toolName', 'title', 'category', 'prompt', 'createdAt', 'updatedAt']) &&
          data.id is string && data.id.size() <= 128 &&
          data.userId is string && data.userId == request.auth.uid &&
          data.toolName is string && data.toolName.size() > 0 && data.toolName.size() <= 100 &&
          data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
          data.prompt is string && data.prompt.size() > 0 && data.prompt.size() <= 5000 &&
          (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
          (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
          (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
      }

      match /custom_prompts/{promptId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(promptId) && isValidCustomPrompt(incoming());
        allow update: if isOwner(userId) && isValidId(promptId) && isValidCustomPrompt(incoming()) &&
          incoming().userId == existing().userId &&
          (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
        allow delete: if isOwner(userId);
      }
    }

    // 4. Tool Reviews: /tool_reviews/{reviewId}
    function isValidToolReview(data) {
      return data.keys().hasAll(['id', 'toolId', 'userId', 'userName', 'rating', 'comment']) &&
        data.keys().hasOnly(['id', 'toolId', 'userId', 'userName', 'userPhoto', 'rating', 'comment', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.toolId is string && data.toolId.size() > 0 && data.toolId.size() <= 64 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
        (!('userPhoto' in data) || (data.userPhoto is string && data.userPhoto.size() <= 500)) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 1500 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /tool_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && isValidToolReview(incoming());
      allow update: if isSignedIn() && isValidId(reviewId) && isValidToolReview(incoming()) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().toolId == existing().toolId &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
